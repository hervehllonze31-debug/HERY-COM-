    def owner_stats(self):

        conn = get_db()

        users = conn.execute("""
            SELECT COUNT(*) AS total
            FROM users
        """).fetchone()["total"]

        products = conn.execute("""
            SELECT COUNT(*) AS total
            FROM products
            WHERE active=1
        """).fetchone()["total"]

        orders = conn.execute("""
            SELECT COUNT(*) AS total
            FROM orders
        """).fetchone()["total"]

        revenue = conn.execute("""
            SELECT COALESCE(
                SUM(total),
                0
            ) AS total
            FROM orders
            WHERE status != 'Annulée'
        """).fetchone()["total"]

        pending = conn.execute("""
            SELECT COUNT(*) AS total
            FROM orders
            WHERE status='En attente'
        """).fetchone()["total"]

        conn.close()

        return send_json(
            self,
            200,
            {
                "success": True,
                "stats": {
                    "users": users,
                    "products": products,
                    "orders": orders,
                    "revenue": revenue,
                    "pending_orders": pending
                }
            }
        )


