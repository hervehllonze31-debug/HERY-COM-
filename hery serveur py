    def owner_update_order_status(
        self,
        order_id,
        data
    ):

        status = str(
            data.get(
                "status",
                ""
            )
        ).strip()

        allowed = [
            "En attente",
            "Confirmée",
            "Préparation",
            "Expédiée",
            "Livrée",
            "Annulée"
        ]

        if status not in allowed:

            return error(
                self,
                400,
                "Statut de commande invalide"
            )

        conn = get_db()

        order = conn.execute("""
            SELECT id
            FROM orders
            WHERE id=?
        """, (
            order_id,
        )).fetchone()

        if not order:

            conn.close()

            return error(
                self,
                404,
                "Commande introuvable"
            )

        conn.execute("""
            UPDATE orders
            SET status=?
            WHERE id=?
        """, (
            status,
            order_id
        ))

        conn.commit()
        conn.close()

        return send_json(
            self,
            200,
            {
                "success": True,
                "message": "Statut de commande modifié",
                "order_id": order_id,
                "status": status
            }
        )

