    # ========================================================
    # PROPRIÉTAIRE : AJOUT PRODUIT
    # ========================================================

    def owner_add_product(self, data):

        name = str(
            data.get("name", "")
        ).strip()

        category = str(
            data.get("category", "")
        ).strip()

        description = str(
            data.get("description", "")
        ).strip()

        emoji = str(
            data.get("emoji", "🛍️")
        ).strip()

        try:

            price = int(
                data.get("price", 0)
            )

            stock = int(
                data.get("stock", 0)
            )

        except Exception:

            return error(
                self,
                400,
                "Prix ou stock invalide"
            )

        if not name:

            return error(
                self,
                400,
                "Le nom du produit est obligatoire"
            )

        if not category:

            return error(
                self,
                400,
                "La catégorie est obligatoire"
            )

        if not description:

            return error(
                self,
                400,
                "La description est obligatoire"
            )

        if price < 0:

            return error(
                self,
                400,
                "Le prix est invalide"
            )

        if stock < 0:

            return error(
                self,
                400,
                "Le stock est invalide"
            )

        conn = get_db()

        cur = conn.execute("""
            INSERT INTO products
            (
                name,
                category,
                description,
                price,
                stock,
                emoji,
                active
            )
            VALUES (?, ?, ?, ?, ?, ?, 1)
        """, (
            name,
            category,
            description,
            price,
            stock,
            emoji
        ))

        conn.commit()

        product_id = cur.lastrowid

        product = conn.execute("""
            SELECT
                id,
                name,
                category,
                description,
                price,
                stock,
                emoji,
                active,
                created_at
            FROM products
            WHERE id=?
        """, (
            product_id,
        )).fetchone()

        conn.close()

        return send_json(
            self,
            201,
            {
                "success": True,
                "message": "Produit ajouté avec succès",
                "product": row_to_dict(product)
            }
        )

