    ):

        conn = get_db()

        old = conn.execute("""
            SELECT *
            FROM products
            WHERE id=?
        """, (
            product_id,
        )).fetchone()

        if not old:

            conn.close()

            return error(
                self,
                404,
                "Produit introuvable"
            )

        name = str(
            data.get(
                "name",
                old["name"]
            )
        ).strip()

        category = str(
            data.get(
                "category",
                old["category"]
            )
        ).strip()

        description = str(
            data.get(
                "description",
                old["description"]
            )
        ).strip()

        emoji = str(
            data.get(
                "emoji",
                old["emoji"]
            )
        ).strip()

        try:

            price = int(
                data.get(
                    "price",
                    old["price"]
                )
            )

            stock = int(
                data.get(
                    "stock",
                    old["stock"]
                )
            )

            active = int(
                data.get(
                    "active",
                    old["active"]
                )
            )

        except Exception:

            conn.close()

            return error(
                self,
                400,
                "Valeur invalide"
            )

        if price < 0 or stock < 0:

            conn.close()

            return error(
                self,
                400,
                "Prix ou stock invalide"
            )

        active = 1 if active else 0

        conn.execute("""
            UPDATE products
            SET
                name=?,
                category=?,
                description=?,
                price=?,
                stock=?,
                emoji=?,
                active=?
            WHERE id=?
        """, (
            name,
            category,
            description,
            price,
            stock,
            emoji,
            active,
            product_id
        ))

        conn.commit()

        product = conn.execute("""
            SELECT
                id,
                name,
                category,
                description,
                price,
                stock,
                emoji,
                active,
                created_at
            FROM products
            WHERE id=?
        """, (
            product_id,
        )).fetchone()

        conn.close()

        return send_json(
            self,
            200,
            {
                "success": True,
                "message": "Produit modifié",
                "product": row_to_dict(product)
            }
        )

